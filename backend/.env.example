PORT=3000
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only. NEVER put this in the Android app or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret you also set as the Authorization header value in the Supabase Database Webhook
WEBHOOK_SECRET=
# Firebase service account JSON, base64-encoded:  base64 -w0 serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_B64=
# Optional TURN (needed for reliable calls on mobile data). Leave empty to use free STUN only.
TURN_URL=
TURN_SECRET=
