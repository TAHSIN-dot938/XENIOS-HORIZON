<resources>
    <!-- Dark from the very first frame: no white flash before Compose draws. -->
    <style name="Theme.Horizon.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/horizon_void</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_horizon_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Horizon</item>
    </style>
    <style name="Theme.Horizon" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/horizon_void</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
